{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Claude Usage",
  "version": "1.21.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "Digital Advanced Solutions",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://claude.ai/*"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "homepage_url": "https://claude-monitor.com/",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "page/dock.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}
